[
  {
    "namespace": "Utilities",
    "functions": [
      {
        "name": "logDebug",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "text",
            "type": "string",
            "description": "what text to log"
          }
        ]
      },

      {
        "name": "showXhtmlPage",
        "type": "function",
        "parameters": [
          {
            "name": "url",
            "type": "string",
            "description": "url to open in browser"
          }
        ]
      },

      {
        "name": "showLicenseDialog",
        "type": "function",
        "parameters": [
          {
            "name": "referrer",
            "type": "string",
            "description": "referrer or feature name to transmit to shop"
          }
        ]
      },

      {
        "name": "showVersionHistory",
        "type": "function",
        "parameters": []
      },

      {
        "name": "getUserName",
        "type": "function",
        "async": true,
        "parameters": []
      },

      {
        "name": "storeConfig",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "config",
            "type": "object",
            "description": "deserialized json structure holding configuration",
            "additionalProperties": true
          }
        ]
      },

      {
        "name": "loadConfig",
        "type": "function",
        "async": true,
        "parameters": []
      },

      {
        "name": "getUserStyle",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "id",
            "type": "string",
            "description": "type of style - first part of identifier"
          },
          {
            "name": "type",
            "type": "string",
            "description": "name of style - 2nd part of identifier"
          },
          {
            "name": "defaultVal",
            "type": "string",
            "description": "default value"
          }
        ]
      },

      {
        "name": "getMailFolder",
        "type": "function",
        "async": true,
        "parameters": [
          {
            "name": "folder",
            "type": "object",
            "description": "nsIMsgFolder"
          }
        ]
      },

      {
        "name": "toggleToolbarAction",
        "type": "function",
        "parameters": [
          {
            "name": "keepState",
            "type": "boolean",
            "description": "keep toggle status, and patch only"
          }
        ]
      },

      {
        "name": "displayMainToolbar",
        "type": "function",
        "parameters": [
          {
            "name": "visible",
            "type": "boolean",
            "description": "show/hide toolbar visible (for settings tab only)"
          },
          {
            "name": "inOptions",
            "type": "boolean",
            "optional": true,
            "description": "if we are in options screen (demo mode)"
          }
        ]
      },

      {
        "name": "getFolderIcon",
        "type": "function",
        "async": true,
        "description": "returns custom icon data for a folder / account",
        "parameters": [
          {
            "name": "accountId",
            "type": "string",
            "description": "account key"
          },
          {
            "name": "path",
            "type": "string",
            "optional": true,
            "description": "path of the API folder"
          }
        ]
      },

      {
        "name": "getFolderUri",
        "type": "function",
        "async": true,
        "description": "returns legacy URI for a folder / account",
        "parameters": [
          {
            "name": "accountId",
            "type": "string",
            "description": "account key"
          },
          {
            "name": "path",
            "type": "string",
            "optional": true,
            "description": "path of the API folder"
          }
        ]
      },

      {
        "name": "getActiveThemeId",
        "type": "function",
        "async": false,
        "description": "returns currently active theme id",
        "parameters": []
      },

      {
        "name": "commitActiveThemeId",
        "type": "function",
        "async": true,
        "description": "Set QuickFolders.Styles.loadedTheme to the currently active theme id, so we know what we reset next time.",
        "parameters": [
          {
            "name": "themeId",
            "type": "string",
            "description": "the theme id to persist"
          }
        ]
      },

      {
        "name": "stageThemeChange",
        "type": "function",
        "async": true,
        "description": "prepare theme change",
        "parameters": [
          {
            "name": "themeId",
            "type": "string",
            "description": "the theme id to stage"
          }
        ]
      },

      {
        "type": "function",
        "name": "updatePreferencesCache",
        "description": "updates any data changes to the experimental pref cache",
        "parameters": [
          {
            "name": "data",
            "type": "any",
            "description": "Key/value patch for preference updates"
          }
        ]
      }
    ]
  }
]
